# Copy to .env and fill in your relay. .env is git-ignored.
#
# This is the only configuration the project needs. It is read when you
# run the app from source and baked into the executable by `poe build`,
# so the people you hand the binary to have nothing to set up.

RELAY_HOST=relay.example.com:9009

# Optional. Must match the --pass your relay was started with.
# Leave empty to use croc's default password.
RELAY_PASSWORD=
